POSTGRES_PORT=5432
POSTGRES_USER=antin
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_DB=antin_os

DATABASE_URL=postgresql://antin:replace-with-local-postgres-password@postgres:5432/antin_os?schema=public
NODE_ENV=production
API_PORT=3001
WEB_PORT=5173
WEB_API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=86400
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_PRESIGNED_URL_TTL_SECONDS=900
RESUME_MAX_UPLOAD_BYTES=5242880

AI_DRAFTING_ENABLED=true
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DRAFT_TIMEOUT_MS=30000
AI_DRAFT_RATE_LIMIT=5/60
AI_DRAFT_USAGE_LIMIT=25/86400
AI_DRAFT_MAX_NOTES_LENGTH=2000
AI_DRAFT_MAX_OUTPUT_TOKENS=1200

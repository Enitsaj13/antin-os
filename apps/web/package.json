{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @antin-os/shared build && pnpm --filter @antin-os/api-client build",
    "dev": "vite",
    "prebuild": "pnpm --filter @antin-os/shared build && pnpm --filter @antin-os/api-client build",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "pretest": "pnpm --filter @antin-os/shared build && pnpm --filter @antin-os/api-client build",
    "test": "vitest run"
  },
  "dependencies": {
    "@antin-os/api-client": "workspace:*",
    "@antin-os/shared": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}

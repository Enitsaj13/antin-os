// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobApplicationStatus {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id              String               @id @default(cuid())
  company         String
  position        String
  jobUrl          String?
  source          String?
  salaryRange     String?
  jobDescription  String?
  notes           String?
  status          JobApplicationStatus @default(SAVED)
  applicationDate DateTime?
  interviewDate   DateTime?
  nextActionDate  DateTime?
  followUpNotes   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, updatedAt])
  @@index([applicationDate])
  @@index([interviewDate])
  @@index([nextActionDate])
}

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  summary      String
  description  String?
  techStack    String[]
  repoUrl      String?
  liveUrl      String?
  imageUrl     String?
  imageKey     String?
  isPublic     Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  caseStudy ProjectCaseStudy?

  @@index([isPublic, displayOrder, createdAt])
}

model ProjectCaseStudy {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  context             String
  problem             String
  role                String
  approach            String
  responsibilities    String[]
  technicalChallenges String[]
  outcomes            String[]
  lessonsLearned      String?
  isPublic            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([isPublic])
}

model Profile {
  id                String   @id @default(cuid())
  singletonKey      String   @unique @default("owner")
  fullName          String
  headline          String
  biography         String
  location          String
  email             String
  githubUrl         String?
  linkedinUrl       String?
  profilePictureKey String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Experience {
  id             String    @id @default(cuid())
  company        String
  role           String
  location       String
  employmentType String
  startDate      DateTime
  endDate        DateTime?
  isCurrent      Boolean   @default(false)
  summary        String
  achievements   String[]
  technologies   String[]
  displayOrder   Int
  isPublic       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublic, displayOrder, startDate])
}

model Resume {
  id               String   @id @default(cuid())
  singletonKey     String   @unique @default("owner")
  originalFilename String
  fileSize         Int
  contentType      String
  objectKey        String
  isPublic         Boolean  @default(false)
  uploadedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PortfolioSettings {
  id                 String   @id @default(cuid())
  singletonKey       String   @unique @default("owner")
  showEducation      Boolean  @default(false)
  showCertifications Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Education {
  id           String    @id @default(cuid())
  institution  String
  credential   String
  fieldOfStudy String
  location     String
  startDate    DateTime?
  endDate      DateTime?
  summary      String
  displayOrder Int
  isPublic     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isPublic, displayOrder, startDate])
}

model Certification {
  id             String    @id @default(cuid())
  name           String
  issuer         String
  issueDate      DateTime?
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?
  summary        String
  displayOrder   Int
  isPublic       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublic, displayOrder, issueDate])
}
